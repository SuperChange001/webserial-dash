{
  "$id": "https://webserial-dash.dev/schema/dashboard.schema.json",
  "title": "WebSerial Dash dashboard",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "URL-safe identifier, e.g. \"my-sensor\"."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "default": 100,
      "description": "Sort position in the dashboard picker (lower first).",
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "default": {},
      "type": "object",
      "properties": {
        "baudRate": {
          "default": 115200,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "dataBits": {
          "default": 8,
          "anyOf": [
            {
              "type": "number",
              "const": 7
            },
            {
              "type": "number",
              "const": 8
            }
          ]
        },
        "stopBits": {
          "default": 1,
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "parity": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "even",
            "odd"
          ]
        },
        "flowControl": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "hardware"
          ]
        },
        "bufferSize": {
          "default": 65536,
          "description": "Browser receive buffer in bytes.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "filters": {
          "default": [],
          "description": "Optional USB VID/PID filters for the port chooser.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "usbVendorId": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "usbProductId": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "usbVendorId"
            ]
          }
        },
        "framing": {
          "default": {
            "mode": "delimiter",
            "delimiter": "\\n",
            "maxLength": 4096
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "delimiter"
                },
                "delimiter": {
                  "default": "\\n",
                  "description": "Frame terminator, escapes allowed (\"\\n\", \"\\r\\n\", \"\\x00\").",
                  "type": "string",
                  "minLength": 1
                },
                "maxLength": {
                  "default": 4096,
                  "description": "Drop buffered bytes beyond this if no delimiter arrives.",
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "mode"
              ]
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "startEnd"
                },
                "start": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Start marker, escapes allowed."
                },
                "end": {
                  "type": "string",
                  "minLength": 1,
                  "description": "End marker, escapes allowed."
                },
                "maxLength": {
                  "default": 4096,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "includeMarkers": {
                  "default": false,
                  "description": "Pass the markers to the parser (needed for binary parsers with header bytes).",
                  "type": "boolean"
                }
              },
              "required": [
                "mode",
                "start",
                "end"
              ]
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "length"
                },
                "length": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Fixed frame size in bytes."
                }
              },
              "required": [
                "mode",
                "length"
              ]
            }
          ],
          "description": "How the byte stream is cut into frames before parsing."
        },
        "parser": {
          "default": {
            "type": "csv",
            "separator": ",",
            "fields": [],
            "header": true
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "csv"
                },
                "separator": {
                  "default": ",",
                  "description": "Field separator. Use \" \" for whitespace separated values.",
                  "type": "string",
                  "minLength": 1
                },
                "fields": {
                  "default": [],
                  "description": "Signal name per column. Missing names become col0, col1, … Use \"\" to skip a column.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "header": {
                  "default": true,
                  "description": "If true, a line whose fields are not all numeric is treated as a header naming the columns (e.g. \"temp,hum\" or \"# temp hum\").",
                  "type": "boolean"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "kv"
                },
                "pairSeparator": {
                  "default": "[,;\\s]+",
                  "description": "Regex separating pairs. Default splits on commas, semicolons and whitespace.",
                  "type": "string"
                },
                "kvSeparator": {
                  "default": "[=:]",
                  "description": "Regex separating key from value (default \"=\" or \":\").",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "json"
                },
                "path": {
                  "description": "Optional dotted path to the object holding the values, e.g. \"data\" for {\"data\":{...}}.",
                  "type": "string"
                },
                "timeKey": {
                  "description": "Key holding a device timestamp in ms; used as sample time when present.",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "teleplot"
                },
                "requirePrefix": {
                  "default": true,
                  "description": "Only accept lines starting with \">\" (Teleplot serial convention).",
                  "type": "boolean"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "regex"
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "description": "JavaScript regex with named groups; each numeric group becomes a signal, e.g. \"T=(?<temp>[-\\\\d.]+)\"."
                },
                "flags": {
                  "default": "",
                  "description": "Regex flags. Add \"g\" to collect every match in the frame.",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "pattern"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "binary"
                },
                "format": {
                  "type": "string",
                  "pattern": "^[<>]?[bBhHiIqQfdx]+$",
                  "description": "struct-style layout: < little-endian (default), > big-endian; b/B int8, h/H int16, i/I int32, q/Q int64, f float32, d float64, x pad byte."
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Signal name per non-pad field, in order."
                },
                "offset": {
                  "default": 0,
                  "description": "Bytes to skip at the start of each frame (e.g. a header).",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "type",
                "format",
                "fields"
              ]
            }
          ]
        },
        "timestamp": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1,
              "description": "Signal that carries the device tick counter, e.g. \"ticks\" from \"ticks=12345 temp=21.5\"."
            },
            "ticksPerSecond": {
              "default": 1000,
              "description": "1000 for millis(), 1000000 for micros() / esp_timer_get_time().",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "use": {
              "default": true,
              "description": "true: time samples by the device clock. false: keep host arrival time; the field is still recorded like any other signal.",
              "type": "boolean"
            },
            "maxDriftMs": {
              "default": 5000,
              "description": "Re-anchor to the host clock when device time drifts further than this.",
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "field"
          ],
          "description": "Optional device timestamp. Firmware may always send ticks; this decides whether the dashboard uses them."
        },
        "simulate": {
          "type": "object",
          "properties": {
            "intervalMs": {
              "default": 100,
              "description": "Milliseconds between generated lines.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "format": {
              "default": "csv",
              "description": "Text format of generated lines; should match source.parser.",
              "type": "string",
              "enum": [
                "csv",
                "kv",
                "json",
                "teleplot"
              ]
            },
            "lineEnding": {
              "default": "\\n",
              "type": "string"
            },
            "signals": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "waveform": {
                    "default": "sine",
                    "description": "\"millis\" emits milliseconds since connect (+min), like Arduino millis().",
                    "type": "string",
                    "enum": [
                      "sine",
                      "square",
                      "triangle",
                      "sawtooth",
                      "noise",
                      "counter",
                      "constant",
                      "millis"
                    ]
                  },
                  "min": {
                    "default": 0,
                    "type": "number"
                  },
                  "max": {
                    "default": 100,
                    "type": "number"
                  },
                  "periodMs": {
                    "default": 5000,
                    "type": "number",
                    "minimum": 0
                  },
                  "decimals": {
                    "default": 2,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "lines": {
              "description": "If set, these lines are replayed in a loop instead of generating signals.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "echo": {
              "default": true,
              "description": "Echo bytes sent to the simulated device back as \"echo: …\" lines.",
              "type": "boolean"
            },
            "responses": {
              "description": "Scripted replies so command buttons work in Demo mode, keyed by the command text. Placeholder {{rand:min:max:decimals}} gives a random number.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Fake device used by Demo mode and tests so the dashboard works without hardware."
        }
      },
      "description": "Serial settings plus how to turn bytes into signals."
    },
    "signals": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "description": "Display name.",
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "scale": {
            "default": 1,
            "description": "value = raw * scale + offset",
            "type": "number"
          },
          "offset": {
            "default": 0,
            "type": "number"
          },
          "decimals": {
            "description": "Decimals when displaying.",
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "color": {
            "description": "CSS color used by plots and tiles.",
            "type": "string"
          }
        },
        "description": "Optional presentation metadata per signal name. Signals not listed here still work."
      }
    },
    "widgets": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "description": "Optional stable id (used as React key and in tests).",
                "type": "string"
              },
              "title": {
                "description": "Header text. Defaults to the signal label.",
                "type": "string"
              },
              "w": {
                "default": 8,
                "description": "Width in grid columns (12-column grid by default).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "h": {
                "default": 3,
                "description": "Height in grid rows (one row ≈ 90 px).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "x": {
                "description": "Optional fixed column (0-based). Omit for auto flow.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "description": "Optional fixed row (0-based).",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "type": {
                "type": "string",
                "const": "plot"
              },
              "signals": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Signal names to draw as lines."
              },
              "timeWindowSec": {
                "description": "Seconds of history shown; defaults to options.timeWindowSec.",
                "type": "number",
                "exclusiveMinimum": 0
              },
              "yMin": {
                "type": "number"
              },
              "yMax": {
                "type": "number"
              },
              "legend": {
                "default": true,
                "type": "boolean"
              },
              "xAxis": {
                "default": "time",
                "description": "\"time\": scrolling time window. \"index\": one x step per sample (#1, #2, …), for occasional events like test results.",
                "type": "string",
                "enum": [
                  "time",
                  "index"
                ]
              },
              "maxPoints": {
                "default": 50,
                "description": "With xAxis \"index\": how many most recent samples to show.",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "points": {
                "description": "Draw a dot per sample. Defaults to true for xAxis \"index\".",
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "signals"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "description": "Optional stable id (used as React key and in tests).",
                "type": "string"
              },
              "title": {
                "description": "Header text. Defaults to the signal label.",
                "type": "string"
              },
              "w": {
                "default": 2,
                "description": "Width in grid columns (12-column grid by default).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "h": {
                "default": 1,
                "description": "Height in grid rows (one row ≈ 90 px).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "x": {
                "description": "Optional fixed column (0-based). Omit for auto flow.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "description": "Optional fixed row (0-based).",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "type": {
                "type": "string",
                "const": "value"
              },
              "signal": {
                "type": "string",
                "description": "Signal to display."
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "unit": {
                "description": "Overrides signals.<name>.unit",
                "type": "string"
              },
              "thresholds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "color": {
                      "type": "string",
                      "description": "CSS color"
                    }
                  },
                  "required": [
                    "value",
                    "color"
                  ]
                },
                "description": "Colour steps: the step with the highest value <= current value wins."
              }
            },
            "required": [
              "type",
              "signal"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "description": "Optional stable id (used as React key and in tests).",
                "type": "string"
              },
              "title": {
                "description": "Header text. Defaults to the signal label.",
                "type": "string"
              },
              "w": {
                "default": 3,
                "description": "Width in grid columns (12-column grid by default).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "h": {
                "default": 2,
                "description": "Height in grid rows (one row ≈ 90 px).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "x": {
                "description": "Optional fixed column (0-based). Omit for auto flow.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "description": "Optional fixed row (0-based).",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "type": {
                "type": "string",
                "const": "gauge"
              },
              "signal": {
                "type": "string"
              },
              "min": {
                "default": 0,
                "description": "Left end of the arc.",
                "type": "number"
              },
              "max": {
                "default": 100,
                "description": "Right end of the arc.",
                "type": "number"
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "unit": {
                "type": "string"
              },
              "thresholds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "color": {
                      "type": "string",
                      "description": "CSS color"
                    }
                  },
                  "required": [
                    "value",
                    "color"
                  ]
                },
                "description": "Colour steps: the step with the highest value <= current value wins."
              },
              "showMinMax": {
                "default": false,
                "description": "Mark the lowest and highest value seen since connect/Clear on the arc and print them below.",
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "signal"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "description": "Optional stable id (used as React key and in tests).",
                "type": "string"
              },
              "title": {
                "description": "Header text. Defaults to the signal label.",
                "type": "string"
              },
              "w": {
                "default": 2,
                "description": "Width in grid columns (12-column grid by default).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "h": {
                "default": 1,
                "description": "Height in grid rows (one row ≈ 90 px).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "x": {
                "description": "Optional fixed column (0-based). Omit for auto flow.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "description": "Optional fixed row (0-based).",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "type": {
                "type": "string",
                "const": "led"
              },
              "signal": {
                "type": "string"
              },
              "when": {
                "default": {
                  "op": ">",
                  "value": 0
                },
                "description": "Condition for the ON state, e.g. {\"op\": \">\", \"value\": 0.5}.",
                "type": "object",
                "properties": {
                  "op": {
                    "default": ">",
                    "type": "string",
                    "enum": [
                      ">",
                      ">=",
                      "<",
                      "<=",
                      "==",
                      "!="
                    ]
                  },
                  "value": {
                    "default": 0,
                    "type": "number"
                  }
                }
              },
              "onColor": {
                "default": "#22c55e",
                "type": "string"
              },
              "offColor": {
                "default": "#334155",
                "type": "string"
              },
              "onLabel": {
                "type": "string"
              },
              "offLabel": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "signal"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "description": "Optional stable id (used as React key and in tests).",
                "type": "string"
              },
              "title": {
                "description": "Header text. Defaults to the signal label.",
                "type": "string"
              },
              "w": {
                "default": 4,
                "description": "Width in grid columns (12-column grid by default).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "h": {
                "default": 3,
                "description": "Height in grid rows (one row ≈ 90 px).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "x": {
                "description": "Optional fixed column (0-based). Omit for auto flow.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "description": "Optional fixed row (0-based).",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "type": {
                "type": "string",
                "const": "table"
              },
              "signals": {
                "default": [],
                "description": "Rows to show. Empty = every signal seen so far.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stats": {
                "default": true,
                "description": "Show min/max/mean columns.",
                "type": "boolean"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "description": "Optional stable id (used as React key and in tests).",
                "type": "string"
              },
              "title": {
                "description": "Header text. Defaults to the signal label.",
                "type": "string"
              },
              "w": {
                "default": 12,
                "description": "Width in grid columns (12-column grid by default).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "h": {
                "default": 4,
                "description": "Height in grid rows (one row ≈ 90 px).",
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "x": {
                "description": "Optional fixed column (0-based). Omit for auto flow.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
